{% extends 'layout.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  <div class="govuk-width-container">
    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        {% if eventRows and eventRows.length %}
          {% set tableRows = [] %}
          {% for row in eventRows %}
            {% set payloadHtml %}<code>{{ row.payload }}</code>{% endset %}
            {% set tableRows = tableRows.concat([[
              { text: row.number },
              { text: row.kind },
              { text: row.createdAt },
              { text: row.createdBy },
              { html: payloadHtml },
              { text: row.closingAmount },
              { text: row.closingAvailableAmount }
            ]]) %}
          {% endfor %}

          {{ govukTable({
            caption: "Waste balance events",
            captionClasses: "govuk-table__caption--m",
            head: [
              { text: "Number" },
              { text: "Kind" },
              { text: "Date" },
              { text: "Created by" },
              { text: "Payload" },
              { text: "Closing balance" },
              { text: "Closing available" }
            ],
            rows: tableRows
          }) }}
        {% else %}
          <p class="govuk-body">No waste balance events</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
