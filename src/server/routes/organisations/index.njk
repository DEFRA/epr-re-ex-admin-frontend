{% extends 'layout.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">All organisations</h1>

      <form method="post" class="app-filters">
        <h2 class="govuk-heading-m">Search for an organisation by</h2>
        <input type="hidden" name="crumb" value="{{ crumb }}" />

        {# Every filled field narrows the results; the backend ANDs them together #}
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: {
                text: "Organisation name",
                classes: "govuk-label--s"
              },
              id: "search",
              name: "search",
              type: "search",
              value: criteria.search,
              autocomplete: "off",
              classes: "govuk-input--width-20"
            }) }}
          </div>
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: {
                text: "Organisation Id",
                classes: "govuk-label--s"
              },
              id: "orgId",
              name: "orgId",
              type: "search",
              value: criteria.orgId,
              autocomplete: "off",
              classes: "govuk-input--width-20"
            }) }}
          </div>
        </div>

        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: {
                text: "Registration number",
                classes: "govuk-label--s"
              },
              id: "registrationNumber",
              name: "registrationNumber",
              type: "search",
              value: criteria.registrationNumber,
              autocomplete: "off",
              classes: "govuk-input--width-20"
            }) }}
          </div>
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: {
                text: "Registration Id",
                classes: "govuk-label--s"
              },
              id: "registrationId",
              name: "registrationId",
              type: "search",
              value: criteria.registrationId,
              autocomplete: "off",
              classes: "govuk-input--width-20"
            }) }}
          </div>
        </div>

        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: {
                text: "Accreditation number",
                classes: "govuk-label--s"
              },
              id: "accreditationNumber",
              name: "accreditationNumber",
              type: "search",
              value: criteria.accreditationNumber,
              autocomplete: "off",
              classes: "govuk-input--width-20"
            }) }}
          </div>
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: {
                text: "Accreditation Id",
                classes: "govuk-label--s"
              },
              id: "accreditationId",
              name: "accreditationId",
              type: "search",
              value: criteria.accreditationId,
              autocomplete: "off",
              classes: "govuk-input--width-20"
            }) }}
          </div>
        </div>

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Search"
          }) }}
          {% if hasCriteria %}
            <a href="/organisations" class="govuk-button govuk-button--inverse">Clear search and view all organisations</a>
          {% endif %}
          </div>
      </form>

    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-body" data-testid="app-page-body">

        {# Render a table when organisations data is provided, otherwise show a message #}
        {% if organisations and organisations.length %}
          {% if hasCriteria %}
            <h2 class="govuk-heading-l">{{ organisations.length }} result{% if organisations.length != 1 %}s{% endif %} found</h2>
          {% endif %}

          {% set tableRows = [] %}
          {% for org in organisations %}
            {% set orgId = org.orgId %}

            {# build cells as objects expected by govukTable #}
            {% set nameCell = { text: org.name } %}
            {% set orgIdCell = { text: orgId } %}
            {# One line per registration, then one per accreditation no registration references #}
            {% set regAccHtml = '' %}
            {% for pair in org.regAccPairs %}
              {% set separator = '' if loop.first else '<br>' %}
              {% set regAccHtml = regAccHtml ~ separator ~ ((pair.registrationNumber or 'None') | escape) ~ ' - ' ~ ((pair.accreditationNumber or 'None') | escape) %}
            {% endfor %}
            {% set regAccCell = { html: regAccHtml } %}

            {% set regulatorCell = { text: org.regulator | upper } %}
            {% set statusCell = { html: govukTag({
              text: org.status
            }) } %}
            {% set actionsHtml = '<a class="govuk-link govuk-link--no-visited-state" href="/organisations/' ~ org.id ~ '/overview">View</a>' %}
            {% set actionsHtml = actionsHtml ~ '<br><a class="govuk-link govuk-link--no-visited-state" href="/organisations/' ~ org.id ~ '">Edit</a>' %}
            {% set actionsHtml = actionsHtml ~ '<br><a class="govuk-link govuk-link--no-visited-state" href="/defra-forms-submission/' ~ org.id ~ '">View submission data</a>' %}
            {% set actionsHtml = actionsHtml ~ '<br><a class="govuk-link govuk-link--no-visited-state" href="/system-logs?referenceNumber=' ~ org.id ~ '">View system logs</a>' %}
            {% set actionsHtml = actionsHtml ~ '<br><a class="govuk-link govuk-link--no-visited-state" href="/linked-organisations?search=' ~ (org.name | urlencode) ~ '">View linked organisations</a>' %}
            {% set actionCell = { html:  actionsHtml } %}

            {% set row = [ nameCell, orgIdCell, regAccCell, regulatorCell, statusCell, actionCell ] %}
            {% set tableRows = tableRows.concat([row]) %}
          {% endfor %}

          {{ govukTable({
            captionClasses: "govuk-table__caption--m",
            firstCellIsHeader: true,
            head: [
              { text: "Name" },
              { text: "Organisation ID" },
              { text: "Reg/Acc Numbers" },
              { text: "Regulator" },
              { text: "Status" },
              { text: "Actions" }
            ],
            rows: tableRows
          }) }}

          {% if pagination.previous or pagination.next %}
            {{ govukPagination({
              previous: pagination.previous,
              next: pagination.next
            }) }}
          {% endif %}

        {% else %}
          {% if hasCriteria %}
            <h2 class="govuk-heading-l">0 results found</h2>
            {{ govukInsetText({
              text: "No organisations found matching your search. Check the values you entered, or search on fewer fields."
            }) }}
          {% else %}
            {{ govukInsetText({ text: "No organisations found." }) }}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

{% endblock %}
