{% extends 'layout.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-width-container">
    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [
          {
            text: error
          }
        ]
      }) }}
    {% endif %}

    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    {% set summaryRows = [
      { key: { text: "Status" }, value: { html: govukTag({ text: registration.status }) }, actions: { items: registrationStatusActions if SCOPES.adminWrite in scopes else [] } },
      { key: { text: "Processing type" }, value: { text: registration.processingType } },
      { key: { text: "Material" }, value: { text: registration.material } },
      { key: { text: "Site" }, value: { text: registration.site } }
    ] %}
    {% if registration.accreditation %}
      {% set summaryRows = summaryRows.concat([
        { key: { text: "Accreditation number" }, value: { text: registration.accreditation.accreditationNumber } },
        { key: { text: "Accreditation status" }, value: { html: govukTag({ text: registration.accreditation.status }) }, actions: { items: accreditationStatusActions if SCOPES.adminWrite in scopes else [] } },
        { key: { text: "Waste balance (tonnes)" }, value: { text: wasteBalance.amount if wasteBalance else "No data" } },
        { key: { text: "Waste balance available (tonnes)" }, value: { text: wasteBalance.availableAmount if wasteBalance else "No data" } },
        { key: { text: "Waste balance events" }, value: { html: '<a class="govuk-link govuk-link--no-visited-state" href="' ~ wasteBalanceEventsUrl ~ '">View</a>' } }
      ]) %}
      {% if overseasSitesUrl %}
        {% set summaryRows = summaryRows.concat([
          { key: { text: "Overseas sites" }, value: { html: '<a class="govuk-link govuk-link--no-visited-state" href="' ~ overseasSitesUrl ~ '">View</a>' } }
        ]) %}
      {% endif %}
    {% endif %}

    {% if wasteRecordsDownloadUrl %}
      {% set summaryRows = summaryRows.concat([
        { key: { text: "Waste records" }, value: { html: '<a class="govuk-link govuk-link--no-visited-state" href="' ~ wasteRecordsDownloadUrl ~ '">Download</a>' } }
      ]) %}
    {% endif %}
    {% if prnActivityDownloadUrl %}
      {% set summaryRows = summaryRows.concat([
        { key: { text: "PRN activity" }, value: { html: '<a class="govuk-link govuk-link--no-visited-state" href="' ~ prnActivityDownloadUrl ~ '">Download</a>' } }
      ]) %}
    {% endif %}

    <div class="govuk-grid-row">
      {# Two-thirds so multi-action rows (e.g. Approve | Reject) keep their
         links horizontally aligned on one line instead of wrapping into a stack. #}
      <div class="govuk-grid-column-two-thirds">
        {{ govukSummaryList({ rows: summaryRows }) }}
      </div>
    </div>
    <div class="govuk-grid-row">
      <div id="reports" class="govuk-grid-column-two-thirds">
        {% if reportRows and reportRows.length %}
          {% set tableRows = [] %}
          {% for row in reportRows %}
            {% set actionsHtml %}
              {% if row.viewUrl %}
                <a class="govuk-link govuk-link--no-visited-state" href="{{ row.viewUrl }}">View</a>
              {% endif %}
              {% if row.unsubmitUrl %}
                <br><a class="govuk-link govuk-link--no-visited-state" href="{{ row.unsubmitUrl }}">Unsubmit</a>
              {% endif %}
            {% endset %}
            {% set tableRows = tableRows.concat([[
              { text: row.formattedPeriod },
              { text: row.submissionNumber },
              { text: row.dueDate },
              { html: govukTag({ text: row.statusText, classes: "app-status-tag" }) } if row.statusText else { text: "" },
              { html: actionsHtml }
            ]]) %}
          {% endfor %}

          {{ govukTable({
            caption: "Reports",
            captionClasses: "govuk-table__caption--m",
            head: [
              { text: "Period" },
              { text: "Submission" },
              { text: "Due" },
              { text: "Status" },
              { text: "Actions" }
            ],
            rows: tableRows
          }) }}
        {% endif %}
      </div>
    </div>
    <div class="govuk-grid-row">
      <div id="summary-logs" class="govuk-grid-column-two-thirds">
        {% if summaryLogRows and summaryLogRows.length %}
          {% set summaryLogTableRows = [] %}
          {% for row in summaryLogRows %}
            {% set actionsHtml %}
              <a class="govuk-link govuk-link--no-visited-state" href="{{ row.viewUrl }}">View</a>
              <br><a class="govuk-link govuk-link--no-visited-state" href="{{ row.downloadUrl }}">Download</a>
            {% endset %}
            {% set summaryLogTableRows = summaryLogTableRows.concat([[
              { text: row.uploadedAt },
              { html: govukTag({ text: row.label, classes: row.className }) },
              { html: actionsHtml }
            ]]) %}
          {% endfor %}

          {{ govukTable({
            caption: "Summary logs",
            captionClasses: "govuk-table__caption--m",
            head: [
              { text: "Uploaded at" },
              { text: "Status" },
              { text: "Actions" }
            ],
            rows: summaryLogTableRows
          }) }}
        {% else %}
          <p class="govuk-body">No summary logs</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
