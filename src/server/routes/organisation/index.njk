{% extends 'layout.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block head %}
  {{ super() }}
  <link href="{{ getAssetPath('jsoneditor.css') }}" rel="stylesheet">
{% endblock %}

{% macro statusActionsHtml(actions) -%}
  {%- for action in actions -%}
    <a class="govuk-link govuk-link--no-visited-state govuk-!-margin-right-3" href="{{ action.href }}">{{ action.text }}<span class="govuk-visually-hidden"> {{ action.visuallyHiddenText }}</span></a>
  {%- endfor -%}
{%- endmacro %}

{% macro statusTable(caption, numberHeading, linkedNumberHeading, rows, showActions) %}
  {% from "govuk/components/table/macro.njk" import govukTable %}
  {% from "govuk/components/tag/macro.njk" import govukTag %}
  {% set head = [
    { text: "ID" },
    { text: numberHeading },
    { text: linkedNumberHeading },
    { text: "Status" }
  ] %}
  {% if showActions %}
    {% set head = head.concat([{ text: "Actions" }]) %}
  {% endif %}

  {% set tableRows = [] %}
  {% for row in rows %}
    {% set cells = [
      { text: row.id },
      { text: row.number },
      { text: row.linkedNumber },
      { html: govukTag({ text: row.status }) }
    ] %}
    {% if showActions %}
      {% set cells = cells.concat([{ html: statusActionsHtml(row.actions) }]) %}
    {% endif %}
    {% set tableRows = tableRows.concat([cells]) %}
  {% endfor %}

  {{ govukTable({
    caption: caption,
    captionClasses: "govuk-table__caption--m",
    head: head,
    rows: tableRows
  }) }}
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if statusChangeError %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [{ text: statusChangeError }]
        }) }}
      {% endif %}

      <div class="govuk-body" data-testid="app-page-body">
        <h1 class="govuk-heading-xl">{{ heading }}</h1>
      </div>

      {% if SCOPES.adminWrite in scopes %}
        <form id="jsoneditor-form" method="POST">
          <input type="hidden" name="crumb" value="{{ crumb }}" />
          {% if message === "success" %}
            {% set html %}
              <p id="organisation-success-message" class="govuk-body">Organisation record updated</p>
            {% endset %}

            {{ govukNotificationBanner({
              html: html,
              type: "success"
            }) }}
          {% endif %}

          {% if errorList %}
            {{ govukErrorSummary({
              titleText: "Failed saving organisation",
              errorList: errorList
            }) }}
          {% endif %}

          <div id="stale-draft-warning-placeholder"></div>

          <div id="jsoneditor" data-testid="organisation-jsoneditor"></div>
          <script id="organisation-json" type="application/json">{{ organisationJson | safe }}</script>

          <input id="jsoneditor-organisation-object" type="hidden" name="organisation" />

          <div class="govuk-button-group govuk-!-margin-bottom-4">
            {{ govukButton({
              text: "Add registration",
              type: "button",
              classes: "govuk-button--secondary",
              id: "add-registration-button"
            }) }}

            {{ govukButton({
              text: "Add accreditation",
              type: "button",
              classes: "govuk-button--secondary",
              id: "add-accreditation-button"
            }) }}
          </div>

          {{ govukButton({
            text: "Reset",
            type: "button",
            classes: "govuk-!-margin-right-2 govuk-button--secondary",
            id: "jsoneditor-reset-button"
          }) }}

          {{ govukButton({
            text: "Save",
            type: "submit",
            id: "jsoneditor-save-button"
          }) }}
        </form>
      {% else %}
        <div id="jsoneditor" data-testid="organisation-jsoneditor" data-readonly="true"></div>
        <script id="organisation-json" type="application/json">{{ organisationJson | safe }}</script>
        <p class="govuk-body govuk-!-margin-top-4">You do not have permission to edit this organisation.</p>
      {% endif %}
    </div>
  </div>

  <div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-full" id="status-changes">
      {% set showActions = SCOPES.adminWrite in scopes %}
      {{ statusTable("Registrations", "Registration number", "Accreditation number", registrationRows, showActions) }}
      {{ statusTable("Accreditations", "Accreditation number", "Registration number", accreditationRows, showActions) }}
    </div>
  </div>
{% endblock %}

{% block pageScripts %}
  <script type="module" src="{{ getAssetPath('jsoneditor.js') }}"></script>
{% endblock %}
